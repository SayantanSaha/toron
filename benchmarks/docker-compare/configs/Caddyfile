{
    admin off
    auto_https off
}

:80 {
    handle_path /node/* {
        reverse_proxy node-origin:9101 {
            transport http {
                keepalive 120s
            }
        }
    }

    handle_path /python/* {
        reverse_proxy python-origin:9102 {
            transport http {
                keepalive 120s
            }
        }
    }

    handle_path /go/* {
        reverse_proxy go-origin:9103 {
            transport http {
                keepalive 120s
            }
        }
    }

    handle_path /fast/* {
        reverse_proxy fast-origin:9104 {
            transport http {
                keepalive 120s
            }
        }
    }

    respond /health 200 {
        body `{"status":"ok","proxy":"caddy"}`
        close
    }
}
